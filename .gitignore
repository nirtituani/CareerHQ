# iCloud Drive conflict copies. This project sits under ~/Documents, which iCloud
# syncs; when it cannot reconcile a fast-changing file it keeps both and names one
# "file 2.ext". They are stale duplicates of real source files and `git add -A`
# would happily commit all of them.
* 2.*
* 2
*\ 2.*

# Personal documents used for manual testing. CVs contain a home address, a
# phone number and an employment history — this repository is public, and
# `git add -A` is one keystroke away from publishing them permanently.
testing files/
*.cv.pdf
