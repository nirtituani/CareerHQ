# CareerHQ — environment configuration
#
# Copy to .env and fill in the blanks:   cp .env.example .env
# .env is gitignored and must never be committed.
#
# The backend validates these at startup and refuses to start when a required
# value is missing, naming the field. See specs/001-platform-foundation/research.md R-007.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ENVIRONMENT=local                     # local | production — controls the Secure cookie flag
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database (PostgreSQL with pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=careerhq
POSTGRES_PASSWORD=careerhq
POSTGRES_DB=careerhq
DATABASE_URL=postgresql+psycopg://careerhq:careerhq@postgres:5432/careerhq

# ---------------------------------------------------------------------------
# Cache — workflow state and caching. Never a source of truth.
#
# OPTIONAL. Leave unset and the platform starts anyway, with readiness
# reporting the cache as `not_configured` rather than failing. Nothing uses it
# until slices 003/004; the deployed environment runs without it today.
#
# Do not set a placeholder value to "fill in the blank" — the application would
# believe it has a cache, construct a client, and fail at first use.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Object storage (MinIO locally, any S3-compatible provider in production)
#
# OPTIONAL, on the same terms as REDIS_URL above. Set all four together or
# none of them — a half-configured client is worse than an absent one.
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=careerhq
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# AI provider (slice 003)
#
# CV extraction is a single structured-output model call through the AI gateway
# (specs/003-data-foundation/research.md R1). OPTIONAL, on the same terms as
# REDIS_URL and S3_* above.
#
# Unset means the stack still starts and readiness reports
# `ai_provider: not_configured`; the import endpoint then returns 503 naming
# the missing setting rather than crashing at startup or silently returning an
# empty extraction. That keeps `docker compose up` working on a clean clone
# before any provider account exists, which docs/06 §7 protects.
#
# AI_PROVIDER defaults to `anthropic`, so supplying a key is usually all that
# is needed.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Set AI_PROVIDER=fixture to return canned structured content for a demo or a
# UI walkthrough. It is labelled as fixture data everywhere it appears, and it
# is NEVER selected by the absence of a key — silently returning canned content
# when a key is missing would mean uploading a real CV and reviewing someone
# else's career history.

# Model per task. The gateway resolves a model from the TASK NAME rather than
# taking one from the caller, which is what lets slice 004 express docs/08
# §3.2.3 (Sonnet to analyze/draft/revise, Opus for the Reviewer and for a
# revision that has already failed once) as configuration rather than as
# branches inside workflow code.
LLM_MODEL_CV_EXTRACTION=anthropic/claude-sonnet-5

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_DAYS=7

# REQUIRED before sign-in can be exercised (not needed for the health checks).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# -> Web application, with authorized redirect URI:
#   http://localhost:3000/api/auth/google/callback
# The origin the browser uses. The backend cannot infer this: the frontend
# proxies /api/* to http://backend:8000, so a redirect URI derived from the
# request would be the internal Docker hostname and Google would reject it.
# Must match the authorized redirect URI in the Google Cloud Console.
PUBLIC_BASE_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# AI — configuration seam only. No AI code exists in this slice.
# ---------------------------------------------------------------------------
# LiteLLM provider/model naming. Alternatives: anthropic/claude-sonnet-5 (cheaper).
LLM_PROVIDER_MODEL=anthropic/claude-opus-5
ANTHROPIC_API_KEY=

# Local by default so the stack runs with no API key. Anthropic provides no
# embeddings endpoint, which is why this is not an Anthropic model.
#
# **This MUST match the model baked into backend/Dockerfile**, and changing it is not a
# free switch. The corpus is embedded with whichever model is set here, and queries use
# the same one; ingesting with one and querying with another returns confident nonsense.
# Both this model and the previous MiniLM default are 384-dimension, so nothing about the
# schema or the vector width catches the difference. Ingestion records the model it used
# and refuses to run against a corpus built with a different one, which is the only thing
# that does catch it. A model this file names but the image does not bake is also
# downloaded from Hugging Face at warm-up, which spec.md D3 rules out.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
BACKEND_URL=http://backend:8000

# ---------------------------------------------------------------------------
# Host ports. Change any that collide with something already running.
# These affect only the host side; containers always talk to each other on the
# internal network using the standard ports.
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Deployment (T003)
#
# These are set in the hosting provider, not in a .env file — they are listed
# here so the deployed configuration is documented in one place with the rest.
# See specs/002-deployment/quickstart.md for the full procedure.
#
#   ENVIRONMENT=production
#       Activates HSTS, the Secure cookie flag, and https_only sessions. It has
#       never run outside `local`, which is why slice 002 verifies those by
#       observing real responses rather than by reading the code.
#
#   PUBLIC_BASE_URL=https://<your-deployed-domain>
#       Must match the authorized redirect URI registered with Google EXACTLY —
#       same scheme, host and path, no trailing slash. Google matches by string,
#       so a near miss fails at the provider with an error describing a mismatch
#       rather than what to fix. The URI to register is:
#           https://<your-deployed-domain>/api/auth/google/callback
#
#   REDIS_URL is deliberately UNSET in deployment. See above.
#
#   S3_* ARE set in deployment from slice 003 onward — a Railway bucket holds
#       the uploaded CVs (FR-021). `railway bucket create`, then
#       `railway bucket credentials`.
#
#   ANTHROPIC_API_KEY is set in deployment from slice 003 onward (FR-028).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Company logos (optional)
# ---------------------------------------------------------------------------
# A logo.dev *publishable* token, from https://www.logo.dev/dashboard/api-keys.
# It travels in the logo image URL, so the browser necessarily sees it — that is
# what "publishable" means and it is not a secret. It still belongs here rather
# than in the source, because this repository is public and a token committed to
# a public repo is one anybody can spend against your quota.
#
# Leave it empty and logos fall back to initials. Nothing else changes.
LOGO_DEV_TOKEN=
